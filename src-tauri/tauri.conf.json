{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2/packages/cli/schema.json",
  "productName": "Mango",
  "version": "0.1.0",
  "identifier": "com.mango.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mango",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {}
}
